{
  "version": "0.1.9",
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "bundle": {
    "active": true,
    "longDescription": "OrigamiVPN desktop client (based on Clash Verge Rev)",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/Assets.car"
    ],
    "resources": ["resources"],
    "publisher": "OrigamiVPN",
    "externalBin": ["sidecar/verge-mihomo", "sidecar/verge-mihomo-alpha"],
    "copyright": "GNU General Public License v3.0",
    "category": "Utility",
    "shortDescription": "OrigamiVPN",
    "createUpdaterArtifacts": true
  },
  "build": {
    "beforeBuildCommand": "pnpm run web:build",
    "frontendDist": "../dist",
    "beforeDevCommand": "pnpm run web:dev",
    "devUrl": "http://localhost:3000/",
    "removeUnusedCommands": true
  },
  "productName": "OrigamiVPN",
  "identifier": "pro.origamivpn.client",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU1NjAzOTk4QkE0MzVEOEIKUldTTFhVTzZtRGxnNWZuSEFBSW5Dcm45YXlaOVoxcjFwRFVYK05rVWk1RkxzYmlISUt1SlpFYkQK",
      "endpoints": [
        "https://github.com/Origamidnd/origami-client/releases/latest/download/latest.json",
      "https://sub.origamivpn.pro/client/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    },
    "deep-link": {
      "desktop": {
        "schemes": ["origamivpn"]
      }
    }
  },
  "app": {
    "security": {
      "capabilities": ["desktop-capability", "migrated"],
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["**"],
          "requireLiteralLeadingDot": false
        }
      },
      "csp": null
    }
  },
  "mainBinaryName": "origamivpn"
}
